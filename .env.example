# Schlüssel für die Envelope-Verschlüsselung: 32 Byte Base64 (npm run gen:key / openssl rand -base64 32)
# oder eine zufällige Zeichenkette mit mindestens 40 Zeichen. NIE ändern, sonst sind gespeicherte Daten unlesbar.
# In Produktion aus einem KMS/Secret-Manager laden, niemals ins Repository einchecken.
DATA_ENCRYPTION_KEY=

# Claude API für die Belegerkennung. Ohne Schlüssel läuft die App im Demo-Modus.
ANTHROPIC_API_KEY=
# Optional: anderes Modell
# ANTHROPIC_MODEL=claude-opus-5-5

# Pfad zur SQLite-Datei (Standard: ./data/steuerklar.db)
# DATABASE_PATH=

# Nur setzen, wenn die App hinter einem vertrauenswürdigen Reverse Proxy läuft (X-Forwarded-For)
# TRUST_PROXY=1
